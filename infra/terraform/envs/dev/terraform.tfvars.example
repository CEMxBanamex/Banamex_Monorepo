# Copia este archivo a terraform.tfvars (no se versiona) y pon los valores reales.
dominio = "<DOMINIO>"

# Nombre del bucket del estado: terraform -chdir=../../bootstrap output -raw bucket
state_bucket = "<BUCKET-DEL-ESTADO>"

# Si a la instancia le falta memoria: instance_type = "t3.medium"
# Cierre del 24 de noviembre: auth_mode = "cognito"
