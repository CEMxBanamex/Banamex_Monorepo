# Variables del entorno local. Copia este archivo a .env (cp .env.example .env; en Windows: copy .env.example .env).
# Nunca subas .env al repo. Los valores de aquí son solo para tu máquina; en dev y prod vienen de SSM Parameter Store
# (/dsa/<env>/...) y nunca se escriben en archivos versionados.
# Docker Compose resuelve ${VAR} con los valores de este mismo archivo.

# --- PostgreSQL local (solo docker-compose.dev.yml) -----------------------------------------------------------------
POSTGRES_PASSWORD=local-postgres
POSTGRES_DB=dsa_local
# Base desechable para las pruebas de integración de datos/ (se borra en cada corrida).
POSTGRES_DB_PRUEBAS=dsa_pruebas
# Puertos publicados solo en 127.0.0.1. Cámbialos si ya los usas.
POSTGRES_PUERTO=5432
BACKEND_PUERTO=8000
MCP_PUERTO=8001
S3_PUERTO=8333

# Contraseñas locales de los usuarios de servicio (las aplica db/roles/01_roles.sql al crear la base).
# Si las cambias después de crear el volumen, corre make reset-db.
CLAVE_MIGRACIONES=local-migraciones
CLAVE_BACKEND=local-backend
CLAVE_MCP=local-mcp
CLAVE_CONSULTAS=local-consultas
CLAVE_CARGA=local-carga

# --- Cadenas de conexión: un usuario por componente (sección 3 de docs/ci-cd) ---------------------------------------
# El host "postgres" es el servicio de Compose. Desde tu máquina (DBeaver, pytest sin Docker) usa localhost:${POSTGRES_PUERTO}.
# Backend: lo de la aplicación.
DATABASE_URL=postgresql+psycopg://steward_backend:${CLAVE_BACKEND}@postgres:5432/${POSTGRES_DB}
# Servidor MCP: lo de las tools.
MCP_DATABASE_URL=postgresql+psycopg://steward_mcp:${CLAVE_MCP}@postgres:5432/${POSTGRES_DB}
# Consulta libre del chat: solo vistas, statement_timeout de 5 s.
CONSULTAS_DATABASE_URL=postgresql+psycopg://steward_consultas:${CLAVE_CONSULTAS}@postgres:5432/${POSTGRES_DB}
# Migraciones (make migrate): dueño del esquema.
MIGRACIONES_DATABASE_URL=postgresql+psycopg://steward_migraciones:${CLAVE_MIGRACIONES}@postgres:5432/${POSTGRES_DB}
# Carga de datos sintéticos (make datos).
CARGA_DATABASE_URL=postgresql+psycopg://steward_carga:${CLAVE_CARGA}@postgres:5432/${POSTGRES_DB}
# Pruebas de integración (make test): superusuario local sobre la base desechable. Solo existe en local.
DATABASE_URL_PRUEBAS=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB_PRUEBAS}

# --- Aplicación ----------------------------------------------------------------------------------------------------
# dev: sin login real (usuario fijo). cognito: valida el JWT de Cognito (última semana del proyecto).
AUTH_MODE=dev
# Rol del usuario fijo del servidor MCP mientras AUTH_MODE=dev: analista o administrador.
MCP_DEV_ROL=analista
# Ollama. Opciones:
#   - Ollama en tu propia máquina:            http://host.docker.internal:11434
#   - Laptop con GPU del equipo por Tailscale: http://<IP-o-nombre-Tailscale>:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# falso: vectores deterministas, sin Ollama (para que make datos funcione en cualquier laptop).
# ollama: embeddings reales con embeddinggemma:300m (necesita OLLAMA_BASE_URL).
EMBEDDING_PROVEEDOR=falso
# Servidor MCP visto desde el backend (red interna de Docker).
MCP_URL=http://mcp:8001/mcp
# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# --- Almacenamiento (S3) -------------------------------------------------------------------------------------------
S3_BUCKET=dsa-local
# Solo local: S3 compatible en Docker (SeaweedFS). En AWS se deja vacío.
S3_ENDPOINT_URL=http://s3:8333
AWS_REGION=us-east-1

# --- Cognito (vacío mientras AUTH_MODE=dev) ------------------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
